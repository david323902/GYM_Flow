# ==================== GYMFLOW BACKEND CONFIGURATION ====================
# Archivo: gymflow-backend/.env
# IMPORTANTE: Este archivo NO debe subirse a Git

# ==================== SERVIDOR ====================
NODE_ENV=development
PORT=5000

# ==================== BASE DE DATOS ====================
MONGODB_URI=mongodb://localhost:27017/gymflow
# Para MongoDB Atlas (producción):
# MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/gymflow

# ==================== SEGURIDAD ====================
JWT_SECRET=gymflow_secret_key_2024_cambiar_en_produccion

# ==================== FRONTEND ====================
FRONTEND_URL=http://localhost:5173

# ==================== EMAIL (GMAIL) ====================
# IMPORTANTE: Usar la contraseña de aplicación de Gmail, no tu contraseña normal
EMAIL_SERVICE=gmail
EMAIL_USER=davidortiz634@gmail.com
EMAIL_PASSWORD=fhabtwullptytijx
EMAIL_FROM="GYM Flow <davidortiz634@gmail.com>"

# Configuración SMTP (alternativa)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

# ==================== NOTIFICACIONES ====================
# Habilitar/deshabilitar notificaciones por email
ENABLE_EMAIL_NOTIFICATIONS=true

# ==================== DESARROLLO ====================
# Mostrar logs detallados
DEBUG=true


